armazenamento_midia/
tmp/
temp/

# Variáveis de ambiente e segredos locais
.env
.env.local
.env.production

# Testes e cobertura Go
*.test
*.out
coverage.txt

# IDEs e Sistema Operacional
.idea/
.vscode/
.omx/
.DS_Store
Thumbs.db

