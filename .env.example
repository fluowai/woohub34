# ==============================================================================
# WOOHUB API - CONFIGURAÇÃO DE PRODUÇÃO (SUPABASE / POSTGRESQL)
# Copie este arquivo para .env e preencha com as credenciais do seu projeto
# ==============================================================================

# Ambiente de execução: "production" ou "development"
AMBIENTE=production

# Porta HTTP do servidor
PORTA=8080

# URL pública da API / Painel (usada em links e CORS restrito se configurado)
URL_PUBLICA=https://api.seudominio.com.br

# Origens permitidas no CORS (separadas por vírgula; use * apenas em desenvolvimento)
CORS_ORIGENS=https://painel.seudominio.com.br,https://api.seudominio.com.br

# ==============================================================================
# BANCO DE DADOS — SUPABASE (PostgreSQL)
# ==============================================================================
# Tipo do banco: "postgres" (ou "supabase") para produção | "sqlite" para dev local
TIPO_BANCO=postgres

# Connection String do Supabase (Project Settings -> Database -> Connection string -> URI)
# Recomendado usar Session Pooler (porta 5432) ou Direct Connection com sslmode=require:
URI_BANCO=postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA-DO-BANCO]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ==============================================================================
# SEGURANÇA E CREDENCIAIS INICIAIS (OBRIGATÓRIO ALTERAR EM PRODUÇÃO)
# ==============================================================================
SEGREDO_JWT=altere_para_uma_chave_aleatoria_com_pelo_menos_32_bytes_aqui
CHAVE_MESTRE=altere_para_uma_chave_mestre_superadmin_segura_aqui

# Credenciais do Super Admin criadas no primeiro boot (se não existir no banco)
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_SENHA=AltereEstaSenhaForte!2026

# Habilitar criação de dados demonstrativos (Agência Vértice / Clínica Essência): "true" ou "false"
SEED_DADOS_DEMO=false

# ==============================================================================
# CONFIGURAÇÕES OPERACIONAIS BRASIL
# ==============================================================================
FUSO_HORARIO=America/Sao_Paulo
LIMITE_PADRAO_INSTANCIAS=100
DIRETORIO_MIDIA=./armazenamento_midia


# ==============================================================================
# LICENCIAMENTO CRIPTOGRÁFICO (PORTAINER STACK / KILL-SWITCH)
# ==============================================================================
EXIGIR_LICENCA=true
WOOHUB_LICENCA_CHAVE=
WOOHUB_SERVIDOR_LICENCA=
WOOHUB_DOMINIO_OFICIAL=api.seudominio.com.br

# ==============================================================================
# STORAGE S3 / MINIO ISOLADO (Custo Zero de Mídia para a Matriz)
# ==============================================================================
STORAGE_DRIVER=local
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=woohub-midias
MINIO_REGIAO=us-east-1
MINIO_USE_SSL=true
MINIO_PUBLIC_URL=

# Resend: e-mail transacional padrão da plataforma
RESEND_API_KEY=
RESEND_FROM=noreply@seudominio.com.br
RESEND_FROM_NAME=WooHub
# Conexão 1-Clique via Resend OAuth (OAuth 2.1 com PKCE)
RESEND_OAUTH_CLIENT_ID=
RESEND_OAUTH_CLIENT_SECRET=
RESEND_OAUTH_REDIRECT_URI=
